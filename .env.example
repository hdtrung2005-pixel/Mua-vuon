SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Ví dụ dùng SQL Server Express với SQL Authentication:
DB_NAME=nongsan_ecommerce
